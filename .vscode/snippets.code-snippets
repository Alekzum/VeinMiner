{
	"Loop function template": {
		"isFileTemplate": true,
		"scope": "mcfunction",
		"prefix": "loop",
		"body": [
			"data modify storage ${3:uvm:data} ${4:tempCoolThing}.current set from storage ${5:uvm:data} ${4:tempCoolThing}.list[-1]",
			"data remove storage ${3:uvm:data} ${4:tempCoolThing}.list[-1]",
			"",
			"${0}",
			"function ${6:cool_function} with storage ${3:uvm:data} ${4:tempCoolThing}",
			"",
			"execute store result score ${2:list_length} ${1:uvm.temp} run data get storage ${5:uvm:data} ${4:tempCoolThing}.list",
			"execute if score ${2:list_length} ${1:uvm.temp} matches 1.. run function ${7:THIS}",
			"",
		],
	},
	"Log to player": {
		"scope": "mcfunction",
		"prefix": "debug",
		"body": "execute if score @s uvm.debug matches 1 run tellraw @s [{\"text\":\"[\", \"color\":\"gray\", \"extra\":[{\"text\":\"uvm:${1:filename}\", \"color\":\"gold\"}, \"]\"]}, \"${2:message}\"]"
	},
	"Trace to player": {
		"scope": "mcfunction",
		"prefix": "trace",
		"body": "execute if score @s uvm.trace matches 1 run tellraw @s [{\"text\":\"[trace] [\", \"color\":\"gray\", \"extra\":[{\"text\":\"uvm:${1:filename}\", \"color\":\"gold\"}, \"] \"]}, \"${2:ping}\"]"
	},
	"Tell to all players": {
		"scope": "mcfunction",
		"prefix": "tell-all",
		"body": "tellraw @a [{\"text\":\"[uvm:${1:filename}] \", \"color\": \"gold\"}, \"${2:ping}\"]"
	},
	"Tell to executor": {
		"scope": "mcfunction",
		"prefix": "tell-executor",
		"body": "tellraw @s [{\"text\":\"[uvm:${1:filename}] \", \"color\": \"gold\"}, \"${2:ping}\"]"
	}
